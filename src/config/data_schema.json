{
  "company_period_schema": {
    "description": "Tidy schema: one record per company-period",
    "fields": {
      "company_name": {
        "type": "string",
        "required": true
      },
      "ticker": {
        "type": "string",
        "required": true,
        "format": "XXXX.SR"
      },
      "fiscal_year": {
        "type": "integer",
        "required": true,
        "range": [2021, 2024]
      },
      "fiscal_period": {
        "type": "string",
        "required": true,
        "enum": ["Q1", "Q2", "Q3", "FY"]
      },
      "reporting_date": {
        "type": "date",
        "required": true
      },
      "source_file_id": {
        "type": "string",
        "required": true
      },
      "source_url": {
        "type": "string",
        "required": true
      }
    },
    "financial_statements": {
      "balance_sheet": {
        "total_assets": {"type": "float"},
        "total_liabilities": {"type": "float"},
        "total_equity": {"type": "float"},
        "current_assets": {"type": "float"},
        "current_liabilities": {"type": "float"},
        "long_term_debt": {"type": "float"},
        "short_term_debt": {"type": "float"},
        "cash_and_equivalents": {"type": "float"},
        "inventory": {"type": "float"},
        "accounts_receivable": {"type": "float"},
        "accounts_payable": {"type": "float"}
      },
      "income_statement": {
        "revenue": {"type": "float"},
        "cost_of_revenue": {"type": "float"},
        "gross_profit": {"type": "float"},
        "operating_income": {"type": "float"},
        "net_income": {"type": "float"},
        "interest_expense": {"type": "float"},
        "ebitda": {"type": "float"},
        "ebit": {"type": "float"}
      },
      "cash_flow": {
        "operating_cash_flow": {"type": "float"},
        "investing_cash_flow": {"type": "float"},
        "financing_cash_flow": {"type": "float"},
        "free_cash_flow": {"type": "float"}
      }
    }
  },
  "feature_schema": {
    "description": "Feature vector for ML model",
    "identifiers": {
      "company_name": {"type": "string", "required": true},
      "ticker": {"type": "string", "required": true},
      "fiscal_year": {"type": "integer", "required": true}
    },
    "financial_ratios": {
      "current_ratio": {
        "type": "float",
        "description": "Current Assets / Current Liabilities",
        "category": "liquidity"
      },
      "quick_ratio": {
        "type": "float",
        "description": "(Current Assets - Inventory) / Current Liabilities",
        "category": "liquidity"
      },
      "cash_ratio": {
        "type": "float",
        "description": "Cash / Current Liabilities",
        "category": "liquidity"
      },
      "debt_to_equity": {
        "type": "float",
        "description": "Total Debt / Total Equity",
        "category": "leverage"
      },
      "debt_to_assets": {
        "type": "float",
        "description": "Total Debt / Total Assets",
        "category": "leverage"
      },
      "long_term_debt_ratio": {
        "type": "float",
        "description": "Long-term Debt / Total Assets",
        "category": "leverage"
      },
      "interest_coverage": {
        "type": "float",
        "description": "EBIT / Interest Expense",
        "category": "coverage"
      },
      "debt_service_coverage": {
        "type": "float",
        "description": "Operating Cash Flow / Total Debt Service",
        "category": "coverage"
      },
      "return_on_assets": {
        "type": "float",
        "description": "Net Income / Total Assets",
        "category": "profitability"
      },
      "return_on_equity": {
        "type": "float",
        "description": "Net Income / Total Equity",
        "category": "profitability"
      },
      "net_margin": {
        "type": "float",
        "description": "Net Income / Revenue",
        "category": "profitability"
      },
      "operating_margin": {
        "type": "float",
        "description": "Operating Income / Revenue",
        "category": "profitability"
      },
      "gross_margin": {
        "type": "float",
        "description": "Gross Profit / Revenue",
        "category": "profitability"
      },
      "asset_turnover": {
        "type": "float",
        "description": "Revenue / Total Assets",
        "category": "efficiency"
      },
      "receivables_turnover": {
        "type": "float",
        "description": "Revenue / Accounts Receivable",
        "category": "efficiency"
      },
      "revenue_growth": {
        "type": "float",
        "description": "(Revenue_t - Revenue_t-1) / Revenue_t-1",
        "category": "growth"
      },
      "net_income_growth": {
        "type": "float",
        "description": "(NI_t - NI_t-1) / NI_t-1",
        "category": "growth"
      }
    },
    "kam_features": {
      "kam_count": {
        "type": "integer",
        "description": "Total number of Key Audit Matters"
      },
      "kam_going_concern": {
        "type": "integer",
        "description": "1 if going concern KAM present, 0 otherwise"
      },
      "kam_impairment": {
        "type": "integer",
        "description": "1 if asset impairment KAM present"
      },
      "kam_revenue_recognition": {
        "type": "integer",
        "description": "1 if revenue recognition KAM present"
      },
      "kam_related_party": {
        "type": "integer",
        "description": "1 if related party transactions KAM present"
      },
      "kam_litigation": {
        "type": "integer",
        "description": "1 if litigation/contingencies KAM present"
      },
      "kam_valuation": {
        "type": "integer",
        "description": "1 if fair value/valuation KAM present"
      },
      "kam_severity_score": {
        "type": "float",
        "description": "Weighted severity score (0-1)"
      }
    },
    "news_features": {
      "news_count": {
        "type": "integer",
        "description": "Total articles in fiscal year"
      },
      "avg_sentiment": {
        "type": "float",
        "description": "Average sentiment score (-1 to 1)"
      },
      "sentiment_std": {
        "type": "float",
        "description": "Sentiment standard deviation"
      },
      "negative_news_ratio": {
        "type": "float",
        "description": "Proportion of negative articles"
      },
      "positive_news_ratio": {
        "type": "float",
        "description": "Proportion of positive articles"
      },
      "event_lawsuit": {
        "type": "integer",
        "description": "Lawsuit/legal mentions count"
      },
      "event_expansion": {
        "type": "integer",
        "description": "Expansion/growth mentions count"
      },
      "event_regulatory": {
        "type": "integer",
        "description": "Regulatory issue mentions count"
      },
      "event_earnings": {
        "type": "integer",
        "description": "Earnings-related mentions count"
      }
    },
    "market_features": {
      "avg_price": {
        "type": "float",
        "description": "Average stock price in fiscal year"
      },
      "price_volatility": {
        "type": "float",
        "description": "Price standard deviation"
      },
      "avg_volume": {
        "type": "float",
        "description": "Average trading volume"
      },
      "market_cap": {
        "type": "float",
        "description": "Market capitalization (year-end)"
      },
      "price_return": {
        "type": "float",
        "description": "Annual price return"
      }
    },
    "target": {
      "tassnief_rating": {
        "type": "string",
        "description": "Tassnief credit rating",
        "enum": ["AAA", "AA+", "AA", "AA-", "A+", "A", "A-", 
                 "BBB+", "BBB", "BBB-", "BB+", "BB", "BB-",
                 "B+", "B", "B-", "CCC+", "CCC", "CCC-", "CC", "C", "D"]
      },
      "rating_bucket": {
        "type": "string",
        "description": "Simplified rating category",
        "enum": ["investment_grade", "speculative"]
      },
      "rating_numeric": {
        "type": "integer",
        "description": "Numeric encoding (21=AAA to 1=D)"
      }
    }
  },
  "rating_schema": {
    "description": "Tassnief credit rating record",
    "fields": {
      "ticker": {"type": "string", "required": true},
      "company_name": {"type": "string", "required": true},
      "rating_date": {"type": "date", "required": true},
      "rating": {"type": "string", "required": true},
      "outlook": {
        "type": "string",
        "enum": ["Positive", "Stable", "Negative", "Watch"]
      },
      "rating_type": {
        "type": "string",
        "enum": ["issuer", "instrument"]
      },
      "source_url": {"type": "string"}
    }
  },
  "kam_schema": {
    "description": "Key Audit Matter record",
    "fields": {
      "ticker": {"type": "string", "required": true},
      "fiscal_year": {"type": "integer", "required": true},
      "kam_title": {"type": "string", "required": true},
      "kam_category": {
        "type": "string",
        "enum": ["going_concern", "impairment", "revenue_recognition", 
                 "related_party", "litigation", "valuation", "other"]
      },
      "kam_text": {"type": "string"},
      "source_page": {"type": "integer"},
      "source_file": {"type": "string"}
    }
  },
  "news_schema": {
    "description": "News article record",
    "fields": {
      "ticker": {"type": "string", "required": true},
      "headline": {"type": "string", "required": true},
      "description": {"type": "string"},
      "source": {"type": "string"},
      "published_date": {"type": "date", "required": true},
      "url": {"type": "string"},
      "sentiment_score": {"type": "float", "range": [-1, 1]},
      "sentiment_label": {
        "type": "string",
        "enum": ["positive", "neutral", "negative"]
      }
    }
  },
  "verdict_schema": {
    "description": "LLM-generated credit verdict",
    "fields": {
      "company_name": {"type": "string", "required": true},
      "ticker": {"type": "string", "required": true},
      "fiscal_year": {"type": "integer", "required": true},
      "overall_assessment": {"type": "string", "required": true},
      "strengths": {
        "type": "array",
        "items": {"type": "string"}
      },
      "weaknesses": {
        "type": "array",
        "items": {"type": "string"}
      },
      "risk_factors": {
        "type": "array",
        "items": {"type": "string"}
      },
      "prediction_analysis": {"type": "string"},
      "predicted_rating": {"type": "string"},
      "actual_rating": {"type": "string"},
      "model_name": {"type": "string"},
      "generation_timestamp": {"type": "datetime"}
    }
  }
}
